# ─────────────────────────────────────────────────────────────
# Commerce Core · Variables de entorno
# Copiá este archivo a `.env` y completá los valores reales.
# `.env` está ignorado por git; `.env.example` se versiona.
# ─────────────────────────────────────────────────────────────

# Base de datos Postgres (Neon, Supabase, Docker local, etc.).
# Prisma la lee vía prisma.config.ts; la app, vía src/core/lib/db.ts.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Cloudinary — cloud name para servir y transformar imágenes.
# `demo` es el cloud público de Cloudinary (datos del seed). Cada
# tienda usa el suyo. Es público (NEXT_PUBLIC_): se usa en el browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"

# Cloudinary — credenciales para SUBIR imágenes desde el panel (M3.3c).
# Sólo server-side. Las sacás de https://cloudinary.com/console
# (requieren un cloud propio — el cloud público `demo` es sólo lectura).
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Carpeta donde se guardan los assets subidos (opcional).
CLOUDINARY_UPLOAD_FOLDER="commerce-core"

# URL pública del sitio — usada en canonical, sitemap.xml y Open Graph.
# En desarrollo, localhost; en producción, el dominio real de la tienda.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth.js · panel admin (M3.1) ─────────────────────────────
# Secreto para firmar las sesiones JWT. Generá uno con: npx auth secret
AUTH_SECRET="cambiá-esto-por-un-secreto-largo-y-aleatorio"

# Confiar en el host de la request. Necesario fuera de Vercel (ej. dev).
AUTH_TRUST_HOST="true"

# Admin PRINCIPAL del panel: su email (podés poner más de uno, separados
# por coma). Clonar una tienda para un cliente = poner acá su email.
ADMIN_EMAILS="dueño@tienda.com"

# Contraseña inicial del admin principal. Se usa en su primer ingreso (se
# guarda hasheada en la base). Cambiala desde el panel después de entrar.
# Los demás usuarios se crean desde /admin/usuarios (clave inicial = DNI).
ADMIN_INITIAL_PASSWORD="cambiá-esto"

# Resend — emails transaccionales de la tienda (confirmación de orden,
# etc.). Ya NO se usa para el login. Opcional: sin esto no se envían.
# API key de https://resend.com/api-keys
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Remitente del email. En dev sirve onboarding@resend.dev; en
# producción, una dirección de un dominio verificado en Resend.
AUTH_EMAIL_FROM="onboarding@resend.dev"

# ── Pagos · Mercado Pago (M2.5) ──────────────────────────────
# Credenciales de la aplicación de la AGENCIA (iguales en todos los
# clones). De https://www.mercadopago.com.ar/developers/panel/app
# La app necesita OAuth habilitado y registrada la redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/payments/mercadopago/callback
MP_CLIENT_ID="0000000000000000"
MP_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clave para cifrar los tokens de pago en la base (32 bytes en base64).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="cambiá-esto-por-una-clave-de-32-bytes-en-base64"

# ── WhatsApp (M6.2) ──────────────────────────────────────────
# OPCIONAL — habilita el botón flotante en el storefront y la opción
# "Coordinar por WhatsApp" en el checkout. Vacío = funciones apagadas.

# Número en formato internacional SIN `+` ni espacios. Ej: 5491123456789.
NEXT_PUBLIC_WHATSAPP_PHONE=""

# Mensaje pre-cargado al abrir wa.me desde el botón flotante.
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hola, tengo una consulta sobre la tienda."

# ── Analytics (M6.1) ─────────────────────────────────────────
# Los dos son OPCIONALES e independientes. Si dejás el ID vacío, ese
# proveedor no se carga ni recibe eventos.

# Google Analytics 4 — el "Measurement ID" (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Meta Pixel (Facebook/Instagram) — el "Pixel ID" numérico.
NEXT_PUBLIC_META_PIXEL_ID=""
